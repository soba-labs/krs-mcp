{
  "name": "krs-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Polish KRS (National Court Register) - search companies by name, KRS, NIP or REGON and fetch official registry extracts.",
  "type": "module",
  "license": "MIT",
  "author": "Soba Labs Prosta Spółka Akcyjna (P.S.A.)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soba-labs/krs-mcp.git"
  },
  "homepage": "https://github.com/soba-labs/krs-mcp#readme",
  "bugs": {
    "url": "https://github.com/soba-labs/krs-mcp/issues"
  },
  "keywords": ["mcp", "krs", "poland", "company-registry"],
  "engines": { "node": ">=22.12.0" },
  "main": "dist/index.js",
  "bin": { "krs-mcp": "dist/index.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "check:live": "npm run build && node scripts/check-live.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  }
}
